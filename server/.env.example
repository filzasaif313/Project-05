# StockSense Server Configuration
PORT=5000
NODE_ENV=development

# Supabase / PostgreSQL Connection String
# Example: postgresql://postgres.xyz:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Fallback Local SQLite database if PostgreSQL is not yet connected
USE_LOCAL_SQLITE_FALLBACK=true

# Security Secrets
JWT_SECRET=stocksense_super_secure_jwt_secret_token_2026_nowshera
INTERNAL_AGENT_SECRET=stocksense_internal_n8n_agent_auth_secret_2026

# n8n AI Agent Webhook URL
N8N_WEBHOOK_URL=http://localhost:5678/webhook/stocksense-agent
